{
	// Tells Cloudflare how to publish this app: serve the built files in dist/
	// and send every unknown address to index.html (it is a single-page app).
	"name": "caregiver-app",
	"compatibility_date": "2026-11-09",
	"assets": {
		"directory": "./dist/",
		"not_found_handling": "single-page-application"
	}
}
